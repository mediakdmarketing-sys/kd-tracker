# Where the backend API lives. Server-side only — this value is never sent to the browser.
API_BASE_URL=http://localhost:4000

# Where employees download the WorkBuddy desktop agent installer (e.g. a public Cloudflare R2
# URL ending in .exe). Leave empty to hide the download buttons.
# AGENT_DOWNLOAD_URL=https://pub-xxxx.r2.dev/WorkBuddy-Setup.exe

# Set to 1 behind HTTPS so session cookies are marked Secure.
# COOKIE_SECURE=1
